{
  "name": "@aliou/pi-harness",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aliou/pi-harness"
  },
  "pi": {
    "extensions": [
      "./commands",
      "./hooks",
      "./tools"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "evals": "vitest run --config evals/vitest.config.ts",
    "evals:ui": "vitest-evals serve .vitest-evals --port 11116",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "extensions:build": "nu scripts/publish-extensions.nu build",
    "extensions:publish": "nu scripts/publish-extensions.nu publish",
    "build:native": "./scripts/build-native-tools.sh",
    "postinstall": "./scripts/build-native-tools.sh"
  },
  "dependencies": {
    "@aliou/pi-utils-ui": "^0.4.1",
    "@aliou/sesame": "^0.11.0",
    "@aliou/sh": "^0.2.0",
    "@harness/agent-kit": "workspace:*",
    "@harness/audio-player": "workspace:*",
    "@harness/completion": "workspace:*",
    "@harness/events": "workspace:*",
    "@harness/image-formats": "workspace:*",
    "@harness/models": "workspace:*",
    "@harness/session-store": "workspace:*",
    "@harness/session-tools": "workspace:*",
    "@harness/subagent-models": "workspace:*",
    "@harness/ui": "workspace:*",
    "@harness/utils": "workspace:*"
  },
  "devDependencies": {
    "@aliou/biome-plugins": "^0.8.1",
    "@biomejs/biome": "^2.5.3",
    "@earendil-works/pi-agent-core": "0.86.1",
    "@earendil-works/pi-ai": "0.86.1",
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@earendil-works/pi-tui": "0.86.1",
    "@golevelup/ts-vitest": "^4.0.0",
    "@harness/test-utils": "workspace:*",
    "@types/node": "^22.0.0",
    "esbuild": "0.28.1",
    "memfs": "^4.64.0",
    "typebox": "1.3.7",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10",
    "vitest-evals": "^0.15.0"
  },
  "packageManager": "pnpm@10.26.1"
}
